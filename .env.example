# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Optional server-wide fallback AI key (server-side only).
# https://aistudio.google.com/apikey
# Users normally connect their own key in Settings > AI engine, which supports
# Gemini, OpenAI, Anthropic, OpenRouter, Groq, DeepSeek, Mistral, xAI, Together,
# Fireworks, Perplexity and any OpenAI-compatible endpoint. That key is stored in
# the user's private Firebase record, never here.
GEMINI_API_KEY=

# Default Gemini model when the fallback key above is used. A fallback model is
# used automatically when this one is retired or unavailable.
GEMINI_MODEL=gemini-3.5-flash

# The Firebase client configuration lives in firebase-applet-config.json so the
# browser SDK and the server-side token verifier read the same project.
# Firestore security rules: deploy firestore.rules to that project.
