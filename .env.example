# ---------------------------------------------------------------------------
# Copy to .env (local dev) or add in Sites -> Secrets (deployment).
# Never commit real values.
# ---------------------------------------------------------------------------

# Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model is swappable without code changes.
GEMINI_MODEL=gemini-3.5-flash

# Both the API key and the Google OAuth client can also be entered in the app
# (Integrations page) and are then stored encrypted in the database. Values
# entered in the app take precedence over the ones in this file.

# Optional: point Gemini at a proxy. Server-side only.
# GEMINI_BASE_URL=

# Google Cloud OAuth client (type: Web application).
# https://console.cloud.google.com/apis/credentials
# Enable "Google Sheets API" and "Gmail API" on the project first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <request origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# 32+ char random string. Encrypts stored Google refresh/access tokens with AES-GCM.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Fallback sign-in for local/self-hosted use when Sign in with Freebuff is not
# configured. On Sites, sign-in with Freebuff is injected automatically and this
# is ignored.
APP_PASSWORD=
APP_SESSION_SECRET=

# Injected by the Sites platform at deploy time (do not set by hand there):
# FREEBUFF_CLIENT_ID, FREEBUFF_ISSUER, APP_ORIGIN
