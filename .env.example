# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (accounts + every table) -------------------------------------
# Project Settings -> API. The anon key is public; the service role key is
# server-only and must never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Workspace (Gmail + Sheets) -------------------------------------
# OAuth client used by the persistent connect flow (refresh token stored in a
# sealed cookie). Redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AES-256-GCM key that encrypts pooled admin AI keys and per-user BYOK keys.
# Required in production. Falls back to TOKEN_ENCRYPTION_KEY when unset.
ENCRYPTION_KEY=

# Encrypts the Google refresh token cookie.
TOKEN_ENCRYPTION_KEY=

# Public origin used inside tracked email pixels.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- AI gateway -------------------------------------------------------------
# Every AI call routes through the unified LLMGateway (lib/llm). Admin pooled
# keys live encrypted in Supabase (Admin -> AI Engine); users can run Managed
# Auto or bring their own key in Settings.
# GEMINI_API_KEY is only a bootstrap fallback so a fresh install can answer
# before an admin adds pooled keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
