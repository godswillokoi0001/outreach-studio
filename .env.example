# ---------------------------------------------------------------------------
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Google AI Studio key (server-side only). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary model. A fallback model is used automatically when this one is
# retired or unavailable (see lib/gemini-utils.ts).
GEMINI_MODEL=gemini-3.5-flash

# The Firebase client configuration lives in firebase-applet-config.json so the
# browser SDK and the server-side token verifier read the same project.
# Firestore security rules: deploy firestore.rules to that project.
