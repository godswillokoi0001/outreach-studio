{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated workspace owner profile and root master gate document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 320 },
        "displayName": { "type": "string", "maxLength": 160 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Sending identity, daily limits, send window, and follow-up defaults.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sender_name": { "type": "string", "maxLength": 160 },
        "sender_role": { "type": "string", "maxLength": 160 },
        "sender_company": { "type": "string", "maxLength": 200 },
        "sender_email": { "type": "string", "maxLength": 320 },
        "signature": { "type": "string", "maxLength": 2000 },
        "daily_limit": { "type": "integer" },
        "campaign_limit": { "type": "integer" },
        "interval_seconds": { "type": "integer" },
        "send_window_start": { "type": "integer" },
        "send_window_end": { "type": "integer" },
        "send_days": { "type": "string", "maxLength": 32 },
        "timezone_offset": { "type": "integer" },
        "followup_days": { "type": "integer" },
        "min_score": { "type": "integer" },
        "unsubscribe_email": { "type": "string", "maxLength": 320 },
        "physical_address": { "type": "string", "maxLength": 400 },
        "model": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "sender_name",
        "sender_role",
        "sender_company",
        "sender_email",
        "signature",
        "daily_limit",
        "campaign_limit",
        "interval_seconds",
        "send_window_start",
        "send_window_end",
        "send_days",
        "timezone_offset",
        "followup_days",
        "min_score",
        "unsubscribe_email",
        "physical_address",
        "model",
        "createdAt",
        "updatedAt"
      ]
    },
    "KnowledgeEntry": {
      "title": "KnowledgeEntry",
      "description": "Master knowledge document or custom knowledge base note.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content": { "type": "string", "maxLength": 50000 },
        "sort": { "type": "integer" },
        "is_master": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "category", "title", "content", "sort", "is_master", "createdAt", "updatedAt"]
    },
    "KnowledgeSource": {
      "title": "KnowledgeSource",
      "description": "Reference URL or pasted document used to ground AI outreach.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "type": "string", "enum": ["url", "text", "document", "note"] },
        "url": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 30000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "label", "kind", "createdAt", "updatedAt"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Structured outreach campaign with native configuration map and status lifecycle.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "instruction": { "type": "string", "maxLength": 4000 },
        "config": { "type": "object" },
        "status": { "type": "string", "enum": ["draft", "approved", "running", "paused", "completed", "archived"] },
        "sheet_source": { "type": "string", "maxLength": 500 },
        "approved_at": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "config", "status", "createdAt", "updatedAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Prospect business record with website research map, qualification score, and outreach status.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "campaign_id": { "type": "string", "maxLength": 128 },
        "business": { "type": "string", "maxLength": 240 },
        "contact_name": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "maxLength": 160 },
        "email": { "type": "string", "maxLength": 320 },
        "email_norm": { "type": "string", "maxLength": 320 },
        "website": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 64 },
        "location": { "type": "string", "maxLength": 200 },
        "industry": { "type": "string", "maxLength": 160 },
        "notes": { "type": "string", "maxLength": 4000 },
        "extra": { "type": "string", "maxLength": 2000 },
        "source": { "type": "string", "maxLength": 64 },
        "source_ref": { "type": "string", "maxLength": 500 },
        "sheet_row": { "type": "integer" },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "queued_research",
            "researched",
            "qualified",
            "disqualified",
            "needs_research",
            "email_generated",
            "approved",
            "sent",
            "replied",
            "bounced",
            "followup_pending",
            "converted",
            "unsubscribed",
            "suppressed"
          ]
        },
        "score": { "type": "integer" },
        "priority": { "type": "string", "enum": ["high", "medium", "low", "not_qualified", "needs_research"] },
        "score_reason": { "type": "object" },
        "research": { "type": "object" },
        "research_at": { "type": "string", "maxLength": 64 },
        "research_ok": { "type": "boolean" },
        "manual_research": { "type": "string", "maxLength": 8000 },
        "last_contacted_at": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "status", "research_ok", "createdAt", "updatedAt"]
    },
    "LeadEvent": {
      "title": "LeadEvent",
      "description": "Immutable timeline event on a prospect record.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lead_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "detail": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "lead_id", "action", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Generated initial or follow-up email tied to a lead and campaign.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lead_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "campaign_id": { "type": "string", "maxLength": 128 },
        "step": { "type": "integer" },
        "kind": { "type": "string", "enum": ["initial", "followup"] },
        "subject": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 12000 },
        "angle": { "type": "string", "maxLength": 300 },
        "rationale": { "type": "string", "maxLength": 4000 },
        "service": { "type": "string", "maxLength": 200 },
        "status": {
          "type": "string",
          "enum": ["draft", "pending_approval", "approved", "sending", "sent", "failed", "skipped", "cancelled"]
        },
        "gmail_id": { "type": "string", "maxLength": 200 },
        "thread_id": { "type": "string", "maxLength": 200 },
        "rfc_message_id": { "type": "string", "maxLength": 300 },
        "sent_at": { "type": "string", "maxLength": 64 },
        "error": { "type": "string", "maxLength": 1000 },
        "approved_at": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "lead_id", "step", "kind", "status", "createdAt", "updatedAt"]
    },
    "Reply": {
      "title": "Reply",
      "description": "Synchronized Gmail reply or bounce with AI classification and suggested answer.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lead_id": { "type": "string", "maxLength": 128 },
        "thread_id": { "type": "string", "maxLength": 200 },
        "gmail_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "from_email": { "type": "string", "maxLength": 320 },
        "subject": { "type": "string", "maxLength": 300 },
        "snippet": { "type": "string", "maxLength": 1000 },
        "body": { "type": "string", "maxLength": 16000 },
        "received_at": { "type": "string", "maxLength": 64 },
        "classification": {
          "type": "string",
          "enum": [
            "interested",
            "more_info",
            "pricing",
            "objection",
            "not_interested",
            "referral",
            "out_of_office",
            "unsubscribe",
            "bounce",
            "other"
          ]
        },
        "summary": { "type": "string", "maxLength": 2000 },
        "recommended_action": { "type": "string", "maxLength": 1000 },
        "draft_reply": { "type": "string", "maxLength": 6000 },
        "handled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "gmail_id", "classification", "handled", "createdAt", "updatedAt"]
    },
    "Suppression": {
      "title": "Suppression",
      "description": "Opted-out or blocked email address that must never be contacted.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 320 },
        "reason": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "email", "reason", "createdAt", "updatedAt"]
    },
    "SendLog": {
      "title": "SendLog",
      "description": "Immutable send confirmation entry used to enforce daily and interval sending limits.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lead_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "message_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["sent", "failed"] },
        "at": { "type": "string", "minLength": 1, "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "lead_id", "message_id", "status", "at", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable operator/system audit trail entry.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 1, "maxLength": 120 },
        "entity": { "type": "string", "minLength": 1, "maxLength": 80 },
        "entity_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "detail": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "action", "entity", "entity_id", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner profile root document and Master Gate for all user workspace subcollections."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User sending identity, limits, and schedule configuration."
    },
    "/users/{userId}/knowledge/{entryId}": {
      "schema": { "$ref": "#/entities/KnowledgeEntry" },
      "description": "Master business knowledge and custom notes."
    },
    "/users/{userId}/knowledgeSources/{sourceId}": {
      "schema": { "$ref": "#/entities/KnowledgeSource" },
      "description": "Reference URLs and documents attached to the knowledge base."
    },
    "/users/{userId}/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/Campaign" },
      "description": "Outreach campaigns owned by the user."
    },
    "/users/{userId}/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Prospect businesses imported from Google Sheets, discovery, or manual entry."
    },
    "/users/{userId}/leadEvents/{eventId}": {
      "schema": { "$ref": "#/entities/LeadEvent" },
      "description": "Immutable audit events for individual leads."
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "AI-composed outreach and follow-up emails awaiting approval or sent via Gmail."
    },
    "/users/{userId}/replies/{replyId}": {
      "schema": { "$ref": "#/entities/Reply" },
      "description": "Synchronized Gmail replies and bounces with AI classification."
    },
    "/users/{userId}/suppressions/{suppressionId}": {
      "schema": { "$ref": "#/entities/Suppression" },
      "description": "Suppressed recipient addresses that block all future sends."
    },
    "/users/{userId}/sendLogs/{logId}": {
      "schema": { "$ref": "#/entities/SendLog" },
      "description": "Immutable send confirmation timestamps used for daily/interval limit enforcement."
    },
    "/users/{userId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable workspace audit trail."
    }
  }
}
