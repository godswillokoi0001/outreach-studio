rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasValidParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    function isOptStr(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isReqStr(data, key, minLen, maxLen) {
      return (key in data) && data[key] is string && data[key].size() >= minLen && data[key].size() <= maxLen;
    }

    function isOptInt(data, key, minVal, maxVal) {
      return !(key in data) || data[key] == null || (data[key] is int && data[key] >= minVal && data[key] <= maxVal);
    }

    function isReqInt(data, key, minVal, maxVal) {
      return (key in data) && data[key] is int && data[key] >= minVal && data[key] <= maxVal;
    }

    function isOptMap(data, key) {
      return !(key in data) || data[key] == null || data[key] is map;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        isReqStr(data, 'email', 3, 320) &&
        isReqStr(data, 'displayName', 0, 160) &&
        isOptStr(data, 'photoURL', 1000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll([
          'ownerId', 'sender_name', 'sender_role', 'sender_company', 'sender_email', 'signature',
          'daily_limit', 'campaign_limit', 'interval_seconds', 'send_window_start', 'send_window_end',
          'send_days', 'timezone_offset', 'followup_days', 'min_score', 'unsubscribe_email',
          'physical_address', 'model', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'sender_name', 'sender_role', 'sender_company', 'sender_email', 'signature',
          'daily_limit', 'campaign_limit', 'interval_seconds', 'send_window_start', 'send_window_end',
          'send_days', 'timezone_offset', 'followup_days', 'min_score', 'unsubscribe_email',
          'physical_address', 'model', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isOptStr(data, 'sender_name', 160) &&
        isOptStr(data, 'sender_role', 160) &&
        isOptStr(data, 'sender_company', 200) &&
        isOptStr(data, 'sender_email', 320) &&
        isOptStr(data, 'signature', 2000) &&
        isReqInt(data, 'daily_limit', 1, 200) &&
        isReqInt(data, 'campaign_limit', 1, 500) &&
        isReqInt(data, 'interval_seconds', 30, 900) &&
        isReqInt(data, 'send_window_start', 0, 23) &&
        isReqInt(data, 'send_window_end', 1, 24) &&
        isOptStr(data, 'send_days', 32) &&
        isReqInt(data, 'timezone_offset', -720, 840) &&
        isReqInt(data, 'followup_days', 1, 30) &&
        isReqInt(data, 'min_score', 0, 100) &&
        isOptStr(data, 'unsubscribe_email', 320) &&
        isOptStr(data, 'physical_address', 400) &&
        isReqStr(data, 'model', 1, 80) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidKnowledgeEntry(data) {
      return data.keys().hasAll(['ownerId', 'category', 'title', 'content', 'sort', 'is_master', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'category', 'title', 'content', 'sort', 'is_master', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isReqStr(data, 'category', 1, 64) &&
        isReqStr(data, 'title', 1, 200) &&
        isReqStr(data, 'content', 0, 50000) &&
        isReqInt(data, 'sort', 0, 10000) &&
        data.is_master is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidKnowledgeSource(data) {
      return data.keys().hasAll(['ownerId', 'label', 'kind', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'label', 'kind', 'url', 'content', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isReqStr(data, 'label', 1, 200) &&
        data.kind in ['url', 'text', 'document', 'note'] &&
        isOptStr(data, 'url', 1000) &&
        isOptStr(data, 'content', 30000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCampaignConfig(cfg) {
      return cfg is map &&
        cfg.keys().hasAll(['services', 'target_industry', 'objective', 'tone', 'min_score', 'lead_count', 'send_limit', 'interval_seconds', 'followup_days', 'auto_approve_initial', 'auto_approve_followups', 'require_approval', 'identity', 'extra_instructions']) &&
        cfg.keys().hasOnly(['services', 'target_industry', 'objective', 'tone', 'min_score', 'lead_count', 'send_limit', 'interval_seconds', 'followup_days', 'auto_approve_initial', 'auto_approve_followups', 'require_approval', 'identity', 'extra_instructions', 'summary', 'warnings']) &&
        cfg.services is list && cfg.services.size() <= 20 &&
        (cfg.services.size() == 0 || cfg.services[0] is string) &&
        cfg.followup_days is list && cfg.followup_days.size() <= 10 &&
        (cfg.followup_days.size() == 0 || cfg.followup_days[0] is int) &&
        cfg.target_industry is string && cfg.target_industry.size() <= 160 &&
        cfg.objective is string && cfg.objective.size() <= 500 &&
        cfg.tone is string && cfg.tone.size() <= 200 &&
        cfg.min_score is int && cfg.min_score >= 0 && cfg.min_score <= 100 &&
        cfg.lead_count is int && cfg.lead_count >= 1 && cfg.lead_count <= 200 &&
        cfg.send_limit is int && cfg.send_limit >= 1 && cfg.send_limit <= 500 &&
        cfg.interval_seconds is int && cfg.interval_seconds >= 30 && cfg.interval_seconds <= 900 &&
        cfg.auto_approve_initial is bool &&
        cfg.auto_approve_followups is bool &&
        cfg.require_approval is bool &&
        cfg.identity in ['personal', 'company'] &&
        cfg.extra_instructions is string && cfg.extra_instructions.size() <= 2000 &&
        isOptStr(cfg, 'summary', 2000) &&
        (!('warnings' in cfg) || (cfg.warnings is list && cfg.warnings.size() <= 20 && (cfg.warnings.size() == 0 || cfg.warnings[0] is string)));
    }

    function isValidCampaign(data) {
      return data.keys().hasAll(['ownerId', 'name', 'config', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'name', 'instruction', 'config', 'status', 'sheet_source', 'approved_at', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isReqStr(data, 'name', 1, 200) &&
        isOptStr(data, 'instruction', 4000) &&
        isValidCampaignConfig(data.config) &&
        data.status in ['draft', 'approved', 'running', 'paused', 'completed', 'archived'] &&
        isOptStr(data, 'sheet_source', 500) &&
        isOptStr(data, 'approved_at', 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['ownerId', 'status', 'research_ok', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'ownerId', 'campaign_id', 'business', 'contact_name', 'role', 'email', 'email_norm',
          'website', 'phone', 'location', 'industry', 'notes', 'extra', 'source', 'source_ref',
          'sheet_row', 'status', 'score', 'priority', 'score_reason', 'research', 'research_at',
          'research_ok', 'manual_research', 'last_contacted_at', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        (!('campaign_id' in data) || data.campaign_id == null || isValidId(data.campaign_id)) &&
        isOptStr(data, 'business', 240) &&
        isOptStr(data, 'contact_name', 160) &&
        isOptStr(data, 'role', 160) &&
        isOptStr(data, 'email', 320) &&
        isOptStr(data, 'email_norm', 320) &&
        isOptStr(data, 'website', 500) &&
        isOptStr(data, 'phone', 64) &&
        isOptStr(data, 'location', 200) &&
        isOptStr(data, 'industry', 160) &&
        isOptStr(data, 'notes', 4000) &&
        isOptStr(data, 'extra', 2000) &&
        isOptStr(data, 'source', 64) &&
        isOptStr(data, 'source_ref', 500) &&
        isOptInt(data, 'sheet_row', 1, 1000000) &&
        data.status in [
          'new', 'queued_research', 'researched', 'qualified', 'disqualified', 'needs_research',
          'email_generated', 'approved', 'sent', 'replied', 'bounced', 'followup_pending',
          'converted', 'unsubscribed', 'suppressed'
        ] &&
        isOptInt(data, 'score', 0, 100) &&
        (!('priority' in data) || data.priority == null || data.priority in ['high', 'medium', 'low', 'not_qualified', 'needs_research']) &&
        isOptMap(data, 'score_reason') &&
        isOptMap(data, 'research') &&
        isOptStr(data, 'research_at', 64) &&
        data.research_ok is bool &&
        isOptStr(data, 'manual_research', 8000) &&
        isOptStr(data, 'last_contacted_at', 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLeadEvent(data) {
      return data.keys().hasAll(['ownerId', 'lead_id', 'action', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'lead_id', 'action', 'detail', 'createdAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.lead_id) &&
        isReqStr(data, 'action', 1, 80) &&
        isOptMap(data, 'detail') &&
        data.createdAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['ownerId', 'lead_id', 'step', 'kind', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'ownerId', 'lead_id', 'campaign_id', 'step', 'kind', 'subject', 'body', 'angle',
          'rationale', 'service', 'status', 'gmail_id', 'thread_id', 'rfc_message_id',
          'sent_at', 'error', 'approved_at', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.lead_id) &&
        (!('campaign_id' in data) || data.campaign_id == null || isValidId(data.campaign_id)) &&
        isReqInt(data, 'step', 1, 20) &&
        data.kind in ['initial', 'followup'] &&
        isOptStr(data, 'subject', 200) &&
        isOptStr(data, 'body', 12000) &&
        isOptStr(data, 'angle', 300) &&
        isOptStr(data, 'rationale', 4000) &&
        isOptStr(data, 'service', 200) &&
        data.status in ['draft', 'pending_approval', 'approved', 'sending', 'sent', 'failed', 'skipped', 'cancelled'] &&
        isOptStr(data, 'gmail_id', 200) &&
        isOptStr(data, 'thread_id', 200) &&
        isOptStr(data, 'rfc_message_id', 300) &&
        isOptStr(data, 'sent_at', 64) &&
        isOptStr(data, 'error', 1000) &&
        isOptStr(data, 'approved_at', 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReply(data) {
      return data.keys().hasAll(['ownerId', 'gmail_id', 'classification', 'handled', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'ownerId', 'lead_id', 'thread_id', 'gmail_id', 'from_email', 'subject', 'snippet',
          'body', 'received_at', 'classification', 'summary', 'recommended_action',
          'draft_reply', 'handled', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        (!('lead_id' in data) || data.lead_id == null || isValidId(data.lead_id)) &&
        isOptStr(data, 'thread_id', 200) &&
        isReqStr(data, 'gmail_id', 1, 200) &&
        isOptStr(data, 'from_email', 320) &&
        isOptStr(data, 'subject', 300) &&
        isOptStr(data, 'snippet', 1000) &&
        isOptStr(data, 'body', 16000) &&
        isOptStr(data, 'received_at', 64) &&
        data.classification in ['interested', 'more_info', 'pricing', 'objection', 'not_interested', 'referral', 'out_of_office', 'unsubscribe', 'bounce', 'other'] &&
        isOptStr(data, 'summary', 2000) &&
        isOptStr(data, 'recommended_action', 1000) &&
        isOptStr(data, 'draft_reply', 6000) &&
        data.handled is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSuppression(data) {
      return data.keys().hasAll(['ownerId', 'email', 'reason', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'reason', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isReqStr(data, 'email', 3, 320) &&
        isReqStr(data, 'reason', 1, 400) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSendLog(data) {
      return data.keys().hasAll(['ownerId', 'lead_id', 'message_id', 'status', 'at', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'lead_id', 'message_id', 'status', 'at', 'createdAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.lead_id) &&
        isValidId(data.message_id) &&
        data.status in ['sent', 'failed'] &&
        isReqStr(data, 'at', 1, 64) &&
        data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['ownerId', 'action', 'entity', 'entity_id', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'action', 'entity', 'entity_id', 'detail', 'createdAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        isReqStr(data, 'action', 1, 120) &&
        isReqStr(data, 'entity', 1, 80) &&
        isReqStr(data, 'entity_id', 1, 128) &&
        isOptMap(data, 'detail') &&
        data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt is timestamp &&
        incoming().updatedAt is timestamp;
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt is timestamp &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /settings/{settingId} {
        allow get: if isOwner(userId) && isValidId(settingId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(settingId) &&
          isValidUserSettings(incoming()) &&
          incoming().createdAt is timestamp &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId);
        allow update: if isOwner(userId) && isValidId(settingId) &&
          isValidUserSettings(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'sender_name', 'sender_role', 'sender_company', 'sender_email', 'signature',
            'daily_limit', 'campaign_limit', 'interval_seconds', 'send_window_start',
            'send_window_end', 'send_days', 'timezone_offset', 'followup_days', 'min_score',
            'unsubscribe_email', 'physical_address', 'model', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /knowledge/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(entryId) &&
          isValidKnowledgeEntry(incoming()) &&
          incoming().createdAt is timestamp &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId);
        allow update: if isOwner(userId) && isValidId(entryId) &&
          isValidKnowledgeEntry(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId) && (
            // Action: Edit knowledge content or metadata
            incoming().diff(existing()).affectedKeys().hasOnly(['category', 'title', 'content', 'sort', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(entryId) &&
          existing().is_master == false &&
          hasValidParentUser(userId);
      }

      match /knowledgeSources/{sourceId} {
        allow get: if isOwner(userId) && isValidId(sourceId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(sourceId) &&
          isValidKnowledgeSource(incoming()) &&
          incoming().createdAt is timestamp &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId);
        allow update: if isOwner(userId) && isValidId(sourceId) &&
          isValidKnowledgeSource(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['label', 'kind', 'url', 'content', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(sourceId) && hasValidParentUser(userId);
      }

      match /campaigns/{campaignId} {
        allow get: if isOwner(userId) && isValidId(campaignId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(campaignId) &&
          isValidCampaign(incoming()) &&
          incoming().createdAt is timestamp &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId);
        allow update: if isOwner(userId) && isValidId(campaignId) &&
          isValidCampaign(incoming()) &&
          existing().status != 'archived' &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId) && (
            // Action: Approve, pause, resume, complete, or archive campaign
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approved_at', 'updatedAt']) ||
            // Action: Update campaign configuration or sheet source
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'instruction', 'config', 'sheet_source', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(campaignId) && hasValidParentUser(userId);
      }

      match /leads/{leadId} {
        allow get: if isOwner(userId) && isValidId(leadId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(leadId) &&
          isValidLead(incoming()) &&
          incoming().createdAt is timestamp &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId) &&
          (!('campaign_id' in incoming()) || incoming().campaign_id == null ||
            exists(/databases/$(database)/documents/users/$(userId)/campaigns/$(incoming().campaign_id)));
        allow update: if isOwner(userId) && isValidId(leadId) &&
          isValidLead(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId) && (
            // Action: Assign lead to campaign
            incoming().diff(existing()).affectedKeys().hasOnly(['campaign_id', 'status', 'updatedAt']) ||
            // Action: Store website research
            incoming().diff(existing()).affectedKeys().hasOnly(['research', 'research_at', 'research_ok', 'status', 'updatedAt']) ||
            // Action: Store qualification score and priority
            incoming().diff(existing()).affectedKeys().hasOnly(['score', 'priority', 'score_reason', 'status', 'updatedAt']) ||
            // Action: Update manual research / notes / requeue
            incoming().diff(existing()).affectedKeys().hasOnly(['manual_research', 'notes', 'research', 'research_at', 'research_ok', 'score', 'priority', 'score_reason', 'status', 'updatedAt']) ||
            // Action: Transition outreach status / last_contacted_at
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'last_contacted_at', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(leadId) && hasValidParentUser(userId);
      }

      match /leadEvents/{eventId} {
        allow get: if isOwner(userId) && isValidId(eventId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(eventId) &&
          isValidLeadEvent(incoming()) &&
          incoming().createdAt is timestamp &&
          hasValidParentUser(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)/leads/$(incoming().lead_id));
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(eventId) && hasValidParentUser(userId);
      }

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(messageId) &&
          isValidMessage(incoming()) &&
          incoming().createdAt is timestamp &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)/leads/$(incoming().lead_id));
        allow update: if isOwner(userId) && isValidId(messageId) &&
          isValidMessage(incoming()) &&
          existing().status != 'sent' &&
          incoming().ownerId == existing().ownerId &&
          incoming().lead_id == existing().lead_id &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId) && (
            // Action: Edit or regenerate draft content
            incoming().diff(existing()).affectedKeys().hasOnly(['subject', 'body', 'angle', 'rationale', 'service', 'updatedAt']) ||
            // Action: Approve or cancel message
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approved_at', 'error', 'updatedAt']) ||
            // Action: Transition sending state and persist Gmail delivery metadata
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rfc_message_id', 'gmail_id', 'thread_id', 'sent_at', 'error', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(messageId) && hasValidParentUser(userId);
      }

      match /replies/{replyId} {
        allow get: if isOwner(userId) && isValidId(replyId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(replyId) &&
          isValidReply(incoming()) &&
          incoming().createdAt is timestamp &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId);
        allow update: if isOwner(userId) && isValidId(replyId) &&
          isValidReply(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().gmail_id == existing().gmail_id &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['handled', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(replyId) && hasValidParentUser(userId);
      }

      match /suppressions/{suppressionId} {
        allow get: if isOwner(userId) && isValidId(suppressionId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(suppressionId) &&
          isValidSuppression(incoming()) &&
          incoming().createdAt is timestamp &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId);
        allow update: if isOwner(userId) && isValidId(suppressionId) &&
          isValidSuppression(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().email == existing().email &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt is timestamp &&
          hasValidParentUser(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['reason', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(suppressionId) && hasValidParentUser(userId);
      }

      match /sendLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(logId) &&
          isValidSendLog(incoming()) &&
          incoming().createdAt is timestamp &&
          hasValidParentUser(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)/leads/$(incoming().lead_id)) &&
          exists(/databases/$(database)/documents/users/$(userId)/messages/$(incoming().message_id));
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(logId) &&
          isValidAuditLog(incoming()) &&
          incoming().createdAt is timestamp &&
          hasValidParentUser(userId);
        allow update, delete: if false;
      }
    }
  }
}
